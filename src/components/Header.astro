---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'RAK Foundations', href: '/services/rak-foundations' },
  { label: 'Services', href: '/services' },
  { label: 'FAQ', href: '/faq' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <img src="/images/jersey-trust-logo.png" alt="Jersey Trust" class="h-14 w-auto" />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-jt-slate hover:text-jt-red transition-colors tracking-wide uppercase"
          >
            {item.label}
          </a>
        ))}
        <a
          href="/contact"
          class="ml-4 px-6 py-2.5 bg-jt-red text-white text-sm font-semibold tracking-wide uppercase rounded hover:bg-jt-red-dark transition-colors"
        >
          Get in Touch
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-jt-navy"
        aria-label="Open menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100">
    <div class="px-6 py-4 space-y-3">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="block text-sm font-medium text-jt-slate hover:text-jt-red transition-colors tracking-wide uppercase py-2"
        >
          {item.label}
        </a>
      ))}
      <a
        href="/contact"
        class="block mt-4 px-6 py-3 bg-jt-red text-white text-sm font-semibold tracking-wide uppercase rounded text-center hover:bg-jt-red-dark transition-colors"
      >
        Get in Touch
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
