---
interface Props {
  darkHero?: boolean;
}

const { darkHero = false } = Astro.props;
const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'RAK Foundations', href: '/services/rak-foundations' },
  { label: 'Services', href: '/services' },
  { label: 'FAQ', href: '/faq' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/' || pathname === '';
  return pathname.startsWith(href);
}

const defaultLinkColour = darkHero ? 'text-white hover:text-jt-gold-light' : 'text-jt-slate hover:text-jt-red';
const mobileButtonColour = darkHero ? 'text-white' : 'text-jt-navy';
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-transparent" data-dark-hero={darkHero ? 'true' : 'false'}>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <a href="/" class="flex items-center gap-3">
        <img src="/images/jersey-trust-logo-updated.png" alt="Jersey Trust" class="h-14 w-auto" />
      </a>

      <nav class="hidden lg:flex items-center gap-8" aria-label="Main navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-sm font-medium transition-colors tracking-wide uppercase nav-link',
              isActive(item.href) ? 'text-jt-red active' : defaultLinkColour,
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
        <a
          href="/contact"
          class:list={[
            'ml-4 px-6 py-2.5 text-sm font-semibold tracking-wide uppercase rounded transition-colors',
            pathname.startsWith('/contact') ? 'bg-jt-red-dark text-white' : 'bg-jt-red text-white hover:bg-jt-red-dark',
          ]}
        >
          Get in Touch
        </a>
      </nav>

      <button
        id="mobile-menu-btn"
        class:list={['lg:hidden p-2 mobile-menu-btn', mobileButtonColour]}
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100 transition-all duration-200">
    <div class="px-6 py-4 space-y-3">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'block text-sm font-medium transition-colors tracking-wide uppercase py-2',
            isActive(item.href) ? 'text-jt-red' : 'text-jt-slate hover:text-jt-red',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/contact"
        class="block mt-4 px-6 py-3 bg-jt-red text-white text-sm font-semibold tracking-wide uppercase rounded text-center hover:bg-jt-red-dark transition-colors"
      >
        Get in Touch
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const navLinks = document.querySelectorAll('.nav-link');
  const mobileBtn = document.querySelector('.mobile-menu-btn');
  const isDarkHero = header?.dataset.darkHero === 'true';

  function updateHeader() {
    if (window.scrollY > 20) {
      header?.classList.add('bg-white/95', 'backdrop-blur-sm', 'border-gray-100', 'shadow-sm');
      header?.classList.remove('border-transparent');
      navLinks.forEach(link => {
        if (!link.classList.contains('active')) {
          link.classList.add('text-jt-slate');
          link.classList.remove('text-white', 'hover:text-jt-gold-light');
          link.classList.add('hover:text-jt-red');
        }
      });
      if (mobileBtn) {
        mobileBtn.classList.add('text-jt-navy');
        mobileBtn.classList.remove('text-white');
      }
    } else {
      header?.classList.remove('bg-white/95', 'backdrop-blur-sm', 'border-gray-100', 'shadow-sm');
      header?.classList.add('border-transparent');
      if (isDarkHero) {
        navLinks.forEach(link => {
          if (!link.classList.contains('active')) {
            link.classList.remove('text-jt-slate', 'hover:text-jt-red');
            link.classList.add('text-white', 'hover:text-jt-gold-light');
          }
        });
        if (mobileBtn) {
          mobileBtn.classList.remove('text-jt-navy');
          mobileBtn.classList.add('text-white');
        }
      }
    }
  }

  window.addEventListener('scroll', updateHeader);
  updateHeader();

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
    btn.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
  });
</script>
