---
const posts = [
  {
    src: '/images/marketing/ig-golden-visa-apply.png',
    alt: 'Apply for your UAE Golden Visa with Jersey Trust',
    href: '/golden-visa',
  },
  {
    src: '/images/marketing/ig-what-is-foundation.png',
    alt: 'What is a Foundation Structure? Asset protection, tax efficiency, confidentiality, and succession planning',
    href: '/foundations',
  },
  {
    src: '/images/marketing/ig-wealth-across-borders.png',
    alt: 'Protect your wealth across borders with Jersey Trust',
    href: '/services',
  },
  {
    src: '/images/marketing/ig-uae-residency-structuring.png',
    alt: 'UAE Residency and Offshore Structuring services',
    href: '/services',
  },
  {
    src: '/images/marketing/ig-foundation-structure-setup.png',
    alt: 'Set up your Foundation Structure for asset protection and tax efficiency',
    href: '/foundations',
  },
  {
    src: '/images/marketing/ig-business-setup-service.png',
    alt: 'Dubai UAE Business Setup Service by Jersey Trust',
    href: '/services',
  },
];
---

<section class="py-20 bg-jt-cream">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-jt-gold text-sm font-semibold tracking-[0.2em] uppercase mb-4">Follow Us</p>
      <h2 class="text-3xl md:text-4xl font-display font-bold text-jt-navy mb-3">
        Latest from Jersey Trust
      </h2>
      <p class="text-jt-slate text-sm max-w-xl mx-auto">
        Stay up to date with our services, insights, and news across social media.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
      {posts.map((post) => (
        <a
          href={post.href}
          class="group relative aspect-square rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300"
        >
          <img
            src={post.src}
            alt={post.alt}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-jt-navy/0 group-hover:bg-jt-navy/30 transition-colors duration-300 flex items-center justify-center">
            <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <div class="text-center mt-10">
      <a
        href="https://www.instagram.com/jerseytrust.ae/"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-jt-red font-semibold text-sm tracking-wide uppercase hover:text-jt-red-dark transition-colors"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        Follow @jerseytrust.ae on Instagram
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</section>
