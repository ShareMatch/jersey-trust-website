---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page Not Found" description="The page you are looking for does not exist.">
  <Header slot="header" />

  <section class="pt-32 pb-24 bg-jt-cream min-h-[60vh] flex items-center">
    <div class="max-w-xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-jt-gold text-sm font-semibold tracking-[0.2em] uppercase mb-4">404</p>
      <h1 class="text-4xl md:text-5xl font-display font-bold text-jt-navy mb-6">
        Page Not Found
      </h1>
      <p class="text-jt-slate text-lg leading-relaxed mb-10">
        The page you are looking for does not exist or has been moved. Let us help you find what you need.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="px-8 py-4 bg-jt-red text-white font-semibold text-sm tracking-wide uppercase rounded hover:bg-jt-red-dark transition-colors">
          Back to Home
        </a>
        <a href="/contact" class="px-8 py-4 border border-jt-navy text-jt-navy font-semibold text-sm tracking-wide uppercase rounded hover:bg-jt-navy hover:text-white transition-colors">
          Contact Us
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
